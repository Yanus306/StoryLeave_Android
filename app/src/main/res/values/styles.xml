<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.StoryLeave.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/sl_color_text_primary</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StoryLeave.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/sl_color_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.StoryLeave.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/sl_color_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.StoryLeave.Button.Base" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/sl_button_height</item>
        <item name="android:paddingLeft">@dimen/sl_spacing_xl</item>
        <item name="android:paddingRight">@dimen/sl_spacing_xl</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/sl_radius_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.StoryLeave.Button.Primary" parent="Widget.StoryLeave.Button.Base">
        <item name="android:textColor">@color/sl_button_primary_text</item>
        <item name="backgroundTint">@color/sl_button_primary_background</item>
    </style>

    <style name="Widget.StoryLeave.Button.Secondary" parent="Widget.StoryLeave.Button.Base">
        <item name="android:textColor">@color/sl_button_secondary_text</item>
        <item name="backgroundTint">@color/sl_button_secondary_background</item>
        <item name="strokeColor">@color/sl_button_secondary_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.StoryLeave.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/sl_radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/sl_radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/sl_radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/sl_radius_md</item>
        <item name="boxStrokeColor">@color/sl_text_input_stroke</item>
        <item name="hintTextColor">@color/sl_color_text_secondary</item>
    </style>

    <style name="Widget.StoryLeave.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/sl_color_brand_soft</item>
    </style>
</resources>
